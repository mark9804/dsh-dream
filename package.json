{
  "name": "dsh-dream",
  "version": "0.1.7",
  "private": true,
  "description": "Companion-oriented dreaming with agent review, recoverable memory updates and Host compaction.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark9804/dsh-dream.git"
  },
  "homepage": "https://github.com/mark9804/dsh-dream#readme",
  "bugs": {
    "url": "https://github.com/mark9804/dsh-dream/issues"
  },
  "exports": {
    ".": { "types": "./dist/settings/entry.d.ts", "import": "./dist/settings/entry.js" },
    "./runtime": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./configuration": { "types": "./dist/settings/owner.d.ts", "import": "./dist/settings/owner.js" },
    "./client": "./web/client.js",
    "./configuration/locale/*.json": "./locale/*.json",
    "./configuration/icon": "./icon.svg",
    "./runtime/locale/*.json": "./locale/*.json",
    "./runtime/icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/",
    "web/client.js",
    "web/client.js.map",
    "client/NOTICE.md",
    "client/SHADCN_LICENSE.txt",
    "THIRD_PARTY_NOTICES.txt",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/checked-build.js",
    "build:checked": "node scripts/checked-build.js",
    "dev": "node scripts/dev.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "check": "npm run typecheck && node scripts/check.js",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.js",
    "predemo": "npm run build",
    "demo": "node scripts/demo.js",
    "prepack": "npm run build",
    "verify:package": "npm run build && node scripts/verify-package.js",
    "prepublishOnly": "npm run check && npm test && npm run verify:package"
  },
  "engines": {
    "node": ">=24.9"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-locale"] }
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.3"
  }
}
