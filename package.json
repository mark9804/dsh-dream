{
  "name": "dsh-dream",
  "version": "0.1.0",
  "private": true,
  "description": "Companion-oriented dreaming with agent review, recoverable memory updates and Host compaction.",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/mark9804/dsh-dream.git" },
  "homepage": "https://github.com/mark9804/dsh-dream#readme",
  "bugs": { "url": "https://github.com/mark9804/dsh-dream/issues" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && node scripts/check.js",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.js",
    "predemo": "npm run build",
    "demo": "node scripts/demo.js",
    "prepack": "npm run build",
    "verify:package": "npm run build && node scripts/verify-package.js",
    "prepublishOnly": "npm run check && npm test && npm run verify:package"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
